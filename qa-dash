#!/usr/bin/env python3
"""qa-dash FILE.rvt [FILE...] [--out DIR] [--max N] [--sheets] -> out/<file>/results.jsonl + dashboard.html (pass/fail table over every exported view)"""
import sys, os, json, html, time, importlib.machinery, importlib.util
HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE)
from qa import gt
ld = importlib.machinery.SourceFileLoader('qav', os.path.join(HERE, 'qa-view')); spec = importlib.util.spec_from_loader('qav', ld); qav = importlib.util.module_from_spec(spec); ld.exec_module(qav)
def main():
    a = sys.argv[1:]; mx = int(a[a.index('--max') + 1]) if '--max' in a else 999
    out = a[a.index('--out') + 1] if '--out' in a else os.path.join(HERE, 'out'); sheets = '--sheets' in a
    files = [x for x in a if x.endswith('.rvt') or x.endswith('.rte')]
    for rvt in files:
        rvt = os.path.abspath(rvt); g = gt.find_gt(rvt)
        if not g: print('no gt for', rvt); continue
        o = os.path.join(out, os.path.basename(rvt)); os.makedirs(o, exist_ok=True)
        vs = gt.views(g); ids = [i for i, v in vs.items() if 'png' in ' '.join(v['files']) and (sheets or v['cls'] != 'ViewSheet')][:mx]
        qav.render(rvt, ids, os.path.join(o, 'ours'))
        rj = os.path.join(o, 'results.jsonl'); rows = [json.loads(l) for l in open(rj)] if os.path.exists(rj) else []
        done = {r['id'] for r in rows}
        for vid in [i for i in ids if i not in done]:
            t = time.time()
            try: r = qav.run_one(rvt, vid, g, o)
            except Exception as ex: r = dict(id=vid, name=vs[vid]['name'], error=repr(ex)[:200])
            r['cls'] = vs[vid]['cls']; r['secs'] = round(time.time() - t, 1); rows.append(r); open(rj, 'a').write(json.dumps(r, default=str) + '\n')
            print(json.dumps({k: r.get(k) for k in ('id', 'name', 'cls', 'pass', 'summary', 'error')}, default=str), flush=True)
        write_html(rows, os.path.join(o, 'dashboard.html'), os.path.basename(rvt))
def write_html(rows, fn, title):
    h = ['<!doctype html><meta charset=utf-8><title>QA %s</title><style>body{font:14px sans-serif;margin:16px}td,th{border:1px solid #ccc;padding:3px 8px}.p{background:#cfc}.f{background:#fcc}.e{background:#ddd}</style><h2>%s</h2><table><tr><th>id<th>class<th>name<th>pass<th>SSIM<th>ink P3<th>ink R3<th>text recall<th>top findings</tr>' % (html.escape(title), html.escape(title))]
    for r in sorted(rows, key=lambda r: (r.get('pass', False), (r.get('summary') or {}).get('ssim') or 0)):
        s = r.get('summary') or {}; c = 'e' if 'error' in r else 'p' if r.get('pass') else 'f'
        top = '; '.join('%s %s' % (f['kind'], f.get('what', f.get('cell', ''))) for f in (r.get('findings') or [])[:3])
        h.append('<tr class=%s><td>%s<td>%s<td>%s<td>%s<td>%s<td>%s<td>%s<td>%s<td>%s</tr>' % (c, r['id'], r.get('cls'), html.escape(str(r.get('name'))), 'ERR' if c == 'e' else (str(r.get('pass')) + ('+vec' if r.get('pass_vector') and not r.get('pass') else '')), s.get('ssim'), s.get('ink_P3'), s.get('ink_R3'), s.get('text_recall'), html.escape(top[:160] if 'error' not in r else r['error'])))
    h.append('</table>'); open(fn, 'w').write('\n'.join(h))
main()

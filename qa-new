#!/bin/bash
# qa-new: run qa-dash (capped, nice 19) for every gt_views dir that has no out/<file>/results.jsonl yet and a locatable source file
cd ~/src/rvt-qa
for d in ~/rvt-research/gt_views/*/; do
  [ -f $d/index.tsv ] || continue
  full=$(head -1 $d/index.tsv | cut -f2); base=${full##*\\}
  src=$(ls ~/rvt-research/corpus/*/$base ~/rvt-research/rosetta/$base 2>/dev/null | head -1)
  # drop the ve_<year>_<name>_<ext>_ prefix of scene exports
  [ -z "$src" ] && src=$(ls ~/rvt-research/rosetta/${base#*_rte_} ~/rvt-research/write-lab/generated/vp/${base#*_rte_} ~/rvt-research/corpus/*/${base#*_rvt_} 2>/dev/null | head -1)
  [ -z "$src" ] && continue
  [ -s out/$(basename $src)/results.jsonl ] && continue
  echo "RUN $src"; systemd-run --user --scope -q -p MemoryMax=3G -p MemorySwapMax=0 -p CPUQuota=100% nice -n 19 .venv/bin/python qa-dash $src --sheets
done
.venv/bin/python qa-index

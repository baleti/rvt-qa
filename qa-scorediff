#!/usr/bin/env python3
"""qa-scorediff OLD_DIR NEW_DIR [--min D] : compare combined scores per (file, view id) between two result trees (e.g. out3 vs out5).
Each tree holds <file>/results.jsonl. Prints drops first, then gains, then pass flips and aggregate medians. Exit 1 if any drop >= --min (default 5)."""
import sys, os, json, statistics, glob
args = [a for a in sys.argv[1:] if not a.startswith('--')]
mn = float(sys.argv[sys.argv.index('--min') + 1]) if '--min' in sys.argv else 5.0
if '--min' in sys.argv: args.remove(sys.argv[sys.argv.index('--min') + 1])
if len(args) != 2: sys.exit(__doc__)
def load(d):
    r = {}
    for p in glob.glob(os.path.join(d, '*', 'results.jsonl')):
        f = os.path.basename(os.path.dirname(p))
        for ln in open(p):
            ln = ln.strip()
            if not ln: continue
            j = json.loads(ln)
            if j.get('score') is not None: r[(f, j['id'])] = j
    return r
a, b = load(args[0]), load(args[1]); rows = []
for k in sorted(set(a) & set(b)):
    rows.append((b[k]['score'] - a[k]['score'], k, a[k], b[k]))
rows.sort(key=lambda x: x[0])
def show(r): d, k, x, y = r; return '%+6.1f  %5.1f -> %5.1f  %-40s %-8s %s' % (d, x['score'], y['score'], k[0], k[1], y.get('name', ''))
print('== drops'); [print(show(r)) for r in rows if r[0] <= -1.0]
print('== gains'); [print(show(r)) for r in reversed(rows) if r[0] >= 1.0]
flips = [r for r in rows if bool(r[2].get('pass')) != bool(r[3].get('pass'))]
print('== pass flips'); [print(('PASS' if r[3].get('pass') else 'FAIL') + ' ' + show(r)) for r in flips]
for f in sorted({k[0] for _, k, _, _ in rows}):
    s = [(x['score'], y['score']) for _, k, x, y in rows if k[0] == f]
    print('%-40s n=%d median %.1f -> %.1f' % (f, len(s), statistics.median(u for u, _ in s), statistics.median(v for _, v in s)))
print('only old: %d, only new: %d' % (len(set(a) - set(b)), len(set(b) - set(a))))
sys.exit(1 if rows and rows[0][0] <= -mn else 0)

#!/usr/bin/env python3
"""qa-layers [out/*.rvt/results.jsonl ...] -> corpus-wide recall per Revit layer (ink-weighted), worst loss first"""
import sys, json, glob, collections
fs = sys.argv[1:] or glob.glob('out/*.rvt/results.jsonl')
agg = collections.defaultdict(lambda: [0, 0.0, 0])
for f in fs:
    for l in open(f):
        r = json.loads(l)
        for x in r.get('layers') or []:
            a = agg[x['layer']]; a[0] += x['ink_px']; a[1] += x['ink_px'] * x['recall']; a[2] += 1
rows = sorted(((k, v[0], v[1] / v[0], v[2]) for k, v in agg.items()), key=lambda t: -t[1] * (1 - t[2]))
print('| layer | views | Revit ink px | recall | lost px |\n|---|---|---|---|---|')
for k, n, rc, v in rows[:25]: print('| %s | %d | %d | %.2f | %d |' % (k, v, n, rc, n * (1 - rc)))

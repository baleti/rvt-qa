#!/usr/bin/env python3
"""qa-textcat [RESULTS_DIR=out] : text-tier findings by category over every non-sheet view (dimension strings, level/grid numbers, tag codes, grid letters, other text),
with matched/missing/extra/moved counts and the worst views per category. Usage: qa-textcat out3"""
import sys
from qa.textcat import summarise

d = sys.argv[1] if len(sys.argv) > 1 else 'out'
summary = summarise(d)
print('%d views with a registered text tier; Revit texts %d, matched %d (%.0f%%)' % (summary['views'], summary['revit'], summary['matched'], 100 * summary['matched'] / max(summary['revit'], 1)))
for c, k in summary['cats'].items():
    print('%-30s %s' % (c, dict(k)))
    for kind in ('text-missing', 'text-moved'):
        w = summary['worst'].get((c, kind), [])
        if w: print('    worst %s: %s' % (kind, ', '.join('%s (%d)' % x for x in w)))

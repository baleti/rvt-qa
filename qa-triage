"""qa-triage OUTDIR [N]: worst non-passing views across all files, with their top finding kinds (cheap: reads results.jsonl only)."""
import sys, json, glob, collections
d = sys.argv[1]; n = int(sys.argv[2]) if len(sys.argv) > 2 else 25
rows = []
for f in glob.glob(f'{d}/*/results.jsonl'):
    fn = f.split('/')[-2]
    for l in open(f):
        r = json.loads(l)
        if r.get('pass') or r.get('pass_vector') or r.get('score') is None: continue
        c = collections.Counter(x['kind'] for x in r.get('findings', []))
        rows.append((r['score'], fn[:14], r['id'], r.get('name', '')[:28], r.get('cls', ''), ', '.join(f'{k}x{v}' for k, v in c.most_common(3))))
rows.sort()
print(f'{len(rows)} failing views; worst {n}:')
for s, fn, i, nm, cls, k in rows[:n]:
    print(f'{s:5.1f} {fn:14} {i:8} {nm:28} {cls:10} {k}')

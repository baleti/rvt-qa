"""Rank the worst non-passing views using results.jsonl files."""
import argparse
import json

from qa.triage import format_rows, triage


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('outdir', metavar='OUTDIR')
    parser.add_argument('n', metavar='N', type=int, nargs='?', default=25)
    parser.add_argument('--json', action='store_true')
    parser.add_argument('--kinds', help='comma-separated finding kinds to count')
    parser.add_argument('--all-kinds', action='store_true',
                        help='include informational finding kinds')
    args = parser.parse_args()
    kinds = None if args.kinds is None else {
        kind.strip() for kind in args.kinds.split(',') if kind.strip()
    }
    rows = triage(args.outdir, include_noise=args.all_kinds, kinds=kinds)
    print(json.dumps(rows[:args.n]) if args.json else format_rows(rows, args.n))


if __name__ == '__main__':
    main()
